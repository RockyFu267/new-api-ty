# Private real file: /data/app/new-api-ty/report-worker.env (root:root 0600).
# Source account: CONNECT + USAGE public + SELECT logs only; no write grants.
DEEPSEEK_REPORT_SOURCE_DSN=postgresql://new_api_bill_source:REPLACE_ME@127.0.0.1:5432/new_api_ty?sslmode=disable&connect_timeout=2&options=-clock_timeout%3D250%20-cstatement_timeout%3D1500%20-cdefault_transaction_read_only%3Don
# Writer owns a separate database. Never point this at new_api_ty.
DEEPSEEK_REPORT_WRITE_DSN=postgresql://new_api_bill_writer:REPLACE_ME@127.0.0.1:5432/new_api_ty_reports?sslmode=disable&connect_timeout=2&options=-clock_timeout%3D250%20-cstatement_timeout%3D1500
DEEPSEEK_REPORT_BATCH=200
# Gateway app/.env needs DEEPSEEK_REPORT_DSN using a third account with SELECT
# only in new_api_ty_reports, with the same timeout/read-only options as source.
